# BuildWithHarshit — Environment Configuration
# Optional: EmailJS configuration for direct automated form delivery
# If omitted, the website automatically falls back to an encoded mailto: submission 
# and one-click inquiry copy so zero inquiries are ever lost.

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
